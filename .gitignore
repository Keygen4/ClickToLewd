# Unreal Engine
# Based on https://github.com/github/gitignore/blob/main/UnrealEngine.gitignore

# Visual Studio / MSVC
.vs/
.vsconfig
*.VC.db
*.VC.opendb
*.suo
*.opensdf
*.sdf
*.user
*.userosscache
*.sln.docstates

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.xcuserstate
*.xccheckout

# Rider / CLion
.idea/
*.sln.DotSettings.user
*.DotSettings.user

# VS Code / Cursor
.vscode/
.cursor/

# Compiled object files
*.slo
*.lo
*.o
*.obj
*.gch
*.pch

# Compiled libraries and executables
*.so
*.dylib
*.dll
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app
*.ipa

# Binary output
Binaries/
Plugins/**/Binaries/

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Editor-generated local state
Saved/
Intermediate/
Plugins/**/Intermediate/
DerivedDataCache/

# Per-user editor folders
Content/Developers/*

# Precompiled source art (keep originals outside Content if needed)
SourceArt/**/*.png
SourceArt/**/*.tga

# Cooked / packaged output
*.pak
*.ucas
*.utoc

# Logs and crash dumps
*.log
*.dmp

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
*~
.directory

# Local Grok ↔ Unreal Editor MCP bridge (personal, do not push)
.grok/
Config/DefaultEditorPerProjectUserSettings.ini
Content/Python/

# Local tooling
*.bak
*.tmp
*.swp
